# --- Build output ---
# CMakePresets.json puts every preset's build in out/build/<preset>.
out/
build/
*.obj
*.pdb
*.ilk
*.exp
*.lib

# --- Visual Studio local state ---
.vs/
CMakeUserPresets.json
CMakeSettings.json

# --- Resource-compiler temporaries ---
# Emitted next to the sources by rc.exe; not inputs to anything.
RCa*

# --- Runtime output (never source) ---
# The rolling log the app writes beside its own exe, and ImGui's window layout.
OptiMax_Profiler.log
OptiMax_Profiler.*.log
imgui.ini

# --- Release / rollback artefacts ---
*.exe
*.backup-*
*.old

# --- Local tooling state ---
# settings.local.json is per-machine by convention; settings.json is shareable.
.claude/settings.local.json

# --- Editor noise ---
*.user
*.suo
Thumbs.db
desktop.ini
