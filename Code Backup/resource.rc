#include "resource.h"
// Every version field below comes from here. These five sites used to be
// hand-maintained literals and were the half of the ten-site problem that
// actually shipped wrong.
#include "OptiMaxVersion.h"
#include <windows.h>

IDI_ICON1 ICON "logo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OPTIMAX_VERSION_COMMA
PRODUCTVERSION OPTIMAX_VERSION_COMMA
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
BLOCK "StringFileInfo"
BEGIN
BLOCK "040904b0"
BEGIN
VALUE "CompanyName", "OptiMax Labs"
VALUE "FileDescription", "OptiMax Pro-Tuner v" OPTIMAX_VERSION_STRING " Release"
VALUE "FileVersion", OPTIMAX_VERSION_STRING_FULL
VALUE "InternalName", "OptiMax_Profiler.exe"
VALUE "LegalCopyright", "Copyright (C) 2026 OptiMax Labs"
VALUE "OriginalFilename", "OptiMax_Profiler.exe"
VALUE "ProductName", "OptiMax Pro-Tuner"
VALUE "ProductVersion", OPTIMAX_VERSION_STRING_FULL
END
END
BLOCK "VarFileInfo"
BEGIN
VALUE "Translation", 0x409, 1200
END
END